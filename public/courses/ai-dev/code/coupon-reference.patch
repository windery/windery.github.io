+package com.example.shop.coupon;
+
+import java.util.List;
+
+import org.springframework.http.HttpStatus;
+import org.springframework.validation.annotation.Validated;
+import org.springframework.web.bind.annotation.GetMapping;
+import org.springframework.web.bind.annotation.PathVariable;
+import org.springframework.web.bind.annotation.PostMapping;
+import org.springframework.web.bind.annotation.RequestBody;
+import org.springframework.web.bind.annotation.ResponseStatus;
+import org.springframework.web.bind.annotation.RestController;
+
+@RestController
+public class CouponController {
+
+    private final CouponService service;
+
+    public CouponController(CouponService service) {
+        this.service = service;
+    }
+
+    @PostMapping("/api/coupons")
+    @ResponseStatus(HttpStatus.CREATED)
+    public CouponResponse create(@Validated @RequestBody CreateCouponRequest request) {
+        return CouponResponse.from(service.create(request));
+    }
+
+    @GetMapping("/api/coupons/{id}")
+    public CouponResponse get(@PathVariable Long id) {
+        return CouponResponse.from(service.get(id));
+    }
+
+    @PostMapping("/api/coupons/{id}/claim")
+    @ResponseStatus(HttpStatus.CREATED)
+    public UserCouponResponse claim(@PathVariable Long id, @Validated @RequestBody ClaimCouponRequest request) {
+        return UserCouponResponse.from(service.claim(id, request.customerId()));
+    }
+
+    @GetMapping("/api/customers/{customerId}/coupons")
+    public List<UserCouponResponse> listForCustomer(@PathVariable String customerId) {
+        return service.listForCustomer(customerId).stream().map(UserCouponResponse::from).toList();
+    }
+}
