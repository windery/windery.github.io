+package com.example.shop.coupon;
+
+import static org.springframework.test.web.servlet.request.MockMvcRequestBuilders.get;
+import static org.springframework.test.web.servlet.request.MockMvcRequestBuilders.post;
+import static org.springframework.test.web.servlet.result.MockMvcResultMatchers.jsonPath;
+import static org.springframework.test.web.servlet.result.MockMvcResultMatchers.status;
+
+import org.junit.jupiter.api.Test;
+import org.springframework.beans.factory.annotation.Autowired;
+import org.springframework.boot.test.context.SpringBootTest;
+import org.springframework.boot.webmvc.test.autoconfigure.AutoConfigureMockMvc;
+import org.springframework.context.annotation.Import;
+import org.springframework.http.MediaType;
+import org.springframework.test.web.servlet.MockMvc;
+
+import com.example.shop.TestClockConfig;
+import com.jayway.jsonpath.JsonPath;
+
+@SpringBootTest
+@AutoConfigureMockMvc
+@Import(TestClockConfig.class)
+class CouponControllerTest {
+
+    @Autowired
+    MockMvc mvc;
+
+
+    @Test
+    void discountMustBeBelowThreshold() throws Exception {
+        mvc.perform(post("/api/coupons").contentType(MediaType.APPLICATION_JSON).content("""
+                {"name": "x", "threshold": 50, "discount": 50, "totalCount": 1, "validUntil": "2026-10-02T00:00:00Z"}
+                """))
+                .andExpect(status().isBadRequest());
+    }
+
+    @Test
+    void validUntilInThePastIs400() throws Exception {
+        mvc.perform(post("/api/coupons").contentType(MediaType.APPLICATION_JSON).content("""
+                {"name": "x", "threshold": 100, "discount": 10, "totalCount": 1, "validUntil": "2026-09-30T00:00:00Z"}
+                """))
+                .andExpect(status().isBadRequest());
+    }
+
+    @Test
+    void claimAndUseCouponThroughApi() throws Exception {
+        String coupon = mvc.perform(post("/api/coupons").contentType(MediaType.APPLICATION_JSON).content("""
+                {"name": "满300减50", "threshold": 300, "discount": 50, "totalCount": 5, "validUntil": "2026-10-02T00:00:00Z"}
+                """))
+                .andExpect(status().isCreated())
+                .andReturn().getResponse().getContentAsString();
+        Number couponId = JsonPath.read(coupon, "$.id");
+
+        String claimed = mvc.perform(post("/api/coupons/{id}/claim", couponId)
+                        .contentType(MediaType.APPLICATION_JSON).content("""
+                                {"customerId": "api-1"}
+                                """))
+                .andExpect(status().isCreated())
+                .andExpect(jsonPath("$.status").value("AVAILABLE"))
+                .andReturn().getResponse().getContentAsString();
+        Number userCouponId = JsonPath.read(claimed, "$.id");
+
+        mvc.perform(post("/api/coupons/{id}/claim", couponId)
+                        .contentType(MediaType.APPLICATION_JSON).content("""
+                                {"customerId": "api-1"}
+                                """))
+                .andExpect(status().isConflict());
+
+        mvc.perform(post("/api/orders").contentType(MediaType.APPLICATION_JSON).content("""
+                {"customerId": "api-1", "items": [{"productId": 1, "quantity": 1}], "userCouponId": %s}
+                """.formatted(userCouponId)))
+                .andExpect(status().isCreated())
+                .andExpect(jsonPath("$.discountAmount").value(50))
+                .andExpect(jsonPath("$.payableAmount").value(349.00));
+
+        mvc.perform(get("/api/customers/api-1/coupons"))
+                .andExpect(status().isOk())
+                .andExpect(jsonPath("$[0].status").value("USED"))
+                .andExpect(jsonPath("$[0].name").value("满300减50"));
+    }
+}
