+package com.example.shop.coupon;
+
+import static org.assertj.core.api.Assertions.assertThat;
+import static org.assertj.core.api.Assertions.assertThatThrownBy;
+
+import java.math.BigDecimal;
+import java.time.Duration;
+import java.time.Instant;
+import java.util.List;
+
+import org.junit.jupiter.api.Test;
+import org.springframework.beans.factory.annotation.Autowired;
+import org.springframework.boot.test.context.SpringBootTest;
+import org.springframework.context.annotation.Import;
+import org.springframework.transaction.annotation.Transactional;
+
+import com.example.shop.TestClockConfig;
+import com.example.shop.common.BusinessException;
+import com.example.shop.order.CreateOrderRequest;
+import com.example.shop.order.Order;
+import com.example.shop.order.OrderService;
+import com.example.shop.order.OrderStatus;
+
+@SpringBootTest
+@Import(TestClockConfig.class)
+@Transactional
+class CouponServiceTest {
+
+    static final Instant TOMORROW = TestClockConfig.NOW.plus(Duration.ofDays(1));
+
+    @Autowired
+    CouponService coupons;
+    @Autowired
+    CouponRepository couponRepository;
+    @Autowired
+    UserCouponRepository userCouponRepository;
+    @Autowired
+    OrderService orders;
+
+    /** 满 300 减 50，共 total 张。 */
+    private Coupon coupon(int total) {
+        return coupons.create(new CreateCouponRequest("满300减50", new BigDecimal("300"), new BigDecimal("50"),
+                total, TOMORROW));
+    }
+
+    /** 直接写库造一张已经过期的券（接口不允许创建过期的券）。 */
+    private Coupon expiredCoupon() {
+        return couponRepository.save(new Coupon("过期券", new BigDecimal("300"), new BigDecimal("50"), 10,
+                TestClockConfig.NOW.minusSeconds(1), TestClockConfig.NOW.minus(Duration.ofDays(2))));
+    }
+
+    /** 1 个机械键盘，总价 399.00。 */
+    private CreateOrderRequest keyboard(String customerId, Long userCouponId) {
+        return new CreateOrderRequest(customerId, List.of(new CreateOrderRequest.Line(1L, 1)), userCouponId);
+    }
+
+    // ---------- 创建 ----------
+
+    @Test
+    void createRejectsValidUntilInThePast() {
+        var request = new CreateCouponRequest("x", new BigDecimal("300"), new BigDecimal("50"), 1,
+                TestClockConfig.NOW);
+
+        assertThatThrownBy(() -> coupons.create(request)).isInstanceOf(IllegalArgumentException.class);
+    }
+
+    // ---------- 领取 ----------
+
+    @Test
+    void claimCreatesAvailableUserCoupon() {
+        Coupon coupon = coupon(10);
+
+        UserCoupon uc = coupons.claim(coupon.getId(), "c-1");
+
+        assertThat(uc.getStatus()).isEqualTo(UserCouponStatus.AVAILABLE);
+        assertThat(coupons.get(coupon.getId()).getClaimedCount()).isEqualTo(1);
+    }
+
+    @Test
+    void claimRejectsExpiredCoupon() {
+        Long id = expiredCoupon().getId();
+
+        assertThatThrownBy(() -> coupons.claim(id, "c-1"))
+                .isInstanceOf(BusinessException.class).hasMessageContaining("过期");
+    }
+
+    @Test
+    void claimRejectsWhenSoldOut() {
+        Long id = coupon(1).getId();
+        coupons.claim(id, "c-1");
+
+        assertThatThrownBy(() -> coupons.claim(id, "c-2"))
+                .isInstanceOf(BusinessException.class).hasMessageContaining("领完");
+    }
+
+    @Test
+    void claimRejectsSecondClaimBySameCustomer() {
+        Long id = coupon(10).getId();
+        coupons.claim(id, "c-1");
+
+        assertThatThrownBy(() -> coupons.claim(id, "c-1"))
+                .isInstanceOf(BusinessException.class).hasMessageContaining("一张");
+        assertThat(coupons.get(id).getClaimedCount()).isEqualTo(1);
+    }
+
+    // ---------- 下单用券 ----------
+
+    @Test
+    void orderWithCouponIsDiscounted() {
+        UserCoupon uc = coupons.claim(coupon(10).getId(), "c-1");
+
+        Order order = orders.create(keyboard("c-1", uc.getId()));
+
+        assertThat(order.getTotalAmount()).isEqualByComparingTo("399.00");
+        assertThat(order.getDiscountAmount()).isEqualByComparingTo("50");
+        assertThat(order.getPayableAmount()).isEqualByComparingTo("349.00");
+        assertThat(uc.getStatus()).isEqualTo(UserCouponStatus.USED);
+        assertThat(uc.getOrderId()).isEqualTo(order.getId());
+    }
+
+    @Test
+    void orderBelowThresholdIsRejected() {
+        UserCoupon uc = coupons.claim(coupon(10).getId(), "c-1");
+        // 2 个显示器支架 = 318.00，满足门槛；1 个只有 159.00
+        var request = new CreateOrderRequest("c-1", List.of(new CreateOrderRequest.Line(2L, 1)), uc.getId());
+
+        assertThatThrownBy(() -> orders.create(request))
+                .isInstanceOf(BusinessException.class).hasMessageContaining("门槛");
+    }
+
+    @Test
+    void orderAtExactlyThresholdIsAccepted() {
+        Coupon coupon = coupons.create(new CreateCouponRequest("满318减18", new BigDecimal("318"),
+                new BigDecimal("18"), 10, TOMORROW));
+        UserCoupon uc = coupons.claim(coupon.getId(), "c-1");
+
+        Order order = orders.create(new CreateOrderRequest("c-1",
+                List.of(new CreateOrderRequest.Line(2L, 2)), uc.getId()));
+
+        assertThat(order.getPayableAmount()).isEqualByComparingTo("300.00");
+    }
+
+    @Test
+    void cannotUseSomeoneElsesCoupon() {
+        UserCoupon uc = coupons.claim(coupon(10).getId(), "c-1");
+
+        assertThatThrownBy(() -> orders.create(keyboard("c-2", uc.getId())))
+                .isInstanceOf(BusinessException.class).hasMessageContaining("不属于");
+    }
+
+    @Test
+    void cannotUseCouponTwice() {
+        UserCoupon uc = coupons.claim(coupon(10).getId(), "c-1");
+        orders.create(keyboard("c-1", uc.getId()));
+
+        assertThatThrownBy(() -> orders.create(keyboard("c-1", uc.getId())))
+                .isInstanceOf(BusinessException.class).hasMessageContaining("不可用");
+    }
+
+    @Test
+    void cannotUseExpiredCoupon() {
+        Coupon expired = expiredCoupon();
+        // 过期券领不到，这里直接造一张“领取后才过期”的记录
+        UserCoupon uc = new UserCoupon(expired, "c-1", TestClockConfig.NOW.minus(Duration.ofDays(1)));
+        Long ucId = userCouponRepository.save(uc).getId();
+
+        assertThatThrownBy(() -> orders.create(keyboard("c-1", ucId)))
+                .isInstanceOf(BusinessException.class).hasMessageContaining("过期");
+    }
+
+    // ---------- 取消退券 ----------
+
+    @Test
+    void cancellingOrderReleasesCoupon() {
+        UserCoupon uc = coupons.claim(coupon(10).getId(), "c-1");
+        Order order = orders.create(keyboard("c-1", uc.getId()));
+
+        Order cancelled = orders.cancel(order.getId());
+
+        assertThat(cancelled.getStatus()).isEqualTo(OrderStatus.CANCELLED);
+        assertThat(uc.getStatus()).isEqualTo(UserCouponStatus.AVAILABLE);
+        assertThat(uc.getOrderId()).isNull();
+        // 退回的券可以再用
+        assertThat(orders.create(keyboard("c-1", uc.getId())).getPayableAmount()).isEqualByComparingTo("349.00");
+    }
+}
