+package com.example.shop.coupon;
+
+import java.math.BigDecimal;
+import java.time.Clock;
+import java.time.Instant;
+import java.util.List;
+
+import org.springframework.dao.DataIntegrityViolationException;
+import org.springframework.stereotype.Service;
+import org.springframework.transaction.annotation.Transactional;
+
+import com.example.shop.common.BusinessException;
+import com.example.shop.common.NotFoundException;
+
+@Service
+public class CouponService {
+
+    private final CouponRepository coupons;
+    private final UserCouponRepository userCoupons;
+    private final Clock clock;
+
+    public CouponService(CouponRepository coupons, UserCouponRepository userCoupons, Clock clock) {
+        this.coupons = coupons;
+        this.userCoupons = userCoupons;
+        this.clock = clock;
+    }
+
+    @Transactional
+    public Coupon create(CreateCouponRequest request) {
+        Instant now = clock.instant();
+        if (!request.validUntil().isAfter(now)) {
+            throw new IllegalArgumentException("截止时间必须晚于当前时间");
+        }
+        return coupons.save(new Coupon(request.name(), request.threshold(), request.discount(),
+                request.totalCount(), request.validUntil(), now));
+    }
+
+    @Transactional(readOnly = true)
+    public Coupon get(Long id) {
+        return coupons.findById(id).orElseThrow(() -> new NotFoundException("优惠券不存在：" + id));
+    }
+
+    /**
+     * 领券。先查重再扣余量，最后插入记录；任何一步失败都会让整个事务回滚，余量不会白扣。
+     * 查重只是为了给出友好的提示，真正保证“一人一张”的是 user_coupon 上的唯一约束。
+     */
+    @Transactional
+    public UserCoupon claim(Long couponId, String customerId) {
+        Coupon coupon = get(couponId);
+        Instant now = clock.instant();
+        if (coupon.isExpired(now)) {
+            throw new BusinessException("优惠券已过期");
+        }
+        if (userCoupons.existsByCouponIdAndCustomerId(couponId, customerId)) {
+            throw new BusinessException("每人只能领取一张");
+        }
+        if (coupons.tryClaimOne(couponId) == 0) {
+            throw new BusinessException("优惠券已领完");
+        }
+        try {
+            return userCoupons.saveAndFlush(new UserCoupon(get(couponId), customerId, now));
+        } catch (DataIntegrityViolationException e) {
+            // 同一用户的并发请求都通过了查重，唯一约束拦下了后到的那个
+            throw new BusinessException("每人只能领取一张");
+        }
+    }
+
+    @Transactional(readOnly = true)
+    public List<UserCoupon> listForCustomer(String customerId) {
+        return userCoupons.findByCustomerIdOrderByIdDesc(customerId);
+    }
+
+    /**
+     * 下单时使用一张券，返回减免金额。调用方需要在同一个事务里。
+     */
+    @Transactional
+    public BigDecimal use(Long userCouponId, String customerId, BigDecimal totalAmount, Long orderId) {
+        UserCoupon userCoupon = userCoupons.findById(userCouponId)
+                .filter(uc -> uc.getCustomerId().equals(customerId))
+                .orElseThrow(() -> new BusinessException("优惠券不属于该用户：" + userCouponId));
+        Coupon coupon = userCoupon.getCoupon();
+        if (coupon.isExpired(clock.instant())) {
+            throw new BusinessException("优惠券已过期");
+        }
+        if (totalAmount.compareTo(coupon.getThreshold()) < 0) {
+            throw new BusinessException("商品总价未达到使用门槛 " + coupon.getThreshold());
+        }
+        userCoupon.markUsed(orderId);
+        return coupon.getDiscount();
+    }
+
+    /** 订单取消时退回优惠券。 */
+    @Transactional
+    public void release(Long userCouponId) {
+        userCoupons.findById(userCouponId).ifPresent(UserCoupon::release);
+    }
+}
