@@ -0,0 +1,24 @@
+package com.example.shop.coupon;
+
+import java.math.BigDecimal;
+import java.time.Instant;
+
+import jakarta.validation.constraints.AssertTrue;
+import jakarta.validation.constraints.DecimalMin;
+import jakarta.validation.constraints.Digits;
+import jakarta.validation.constraints.Min;
+import jakarta.validation.constraints.NotBlank;
+import jakarta.validation.constraints.NotNull;
+
+public record CreateCouponRequest(
+        @NotBlank String name,
+        @NotNull @DecimalMin(value = "0", inclusive = false) @Digits(integer = 10, fraction = 2) BigDecimal threshold,
+        @NotNull @DecimalMin(value = "0", inclusive = false) @Digits(integer = 10, fraction = 2) BigDecimal discount,
+        @Min(1) int totalCount,
+        @NotNull Instant validUntil) {
+
+    @AssertTrue(message = "减免金额必须小于使用门槛")
+    public boolean isDiscountBelowThreshold() {
+        return threshold == null || discount == null || discount.compareTo(threshold) < 0;
+    }
+}
