+package com.example.shop.coupon;
+
+import java.time.Instant;
+
+import com.example.shop.common.BusinessException;
+
+import jakarta.persistence.Entity;
+import jakarta.persistence.EnumType;
+import jakarta.persistence.Enumerated;
+import jakarta.persistence.FetchType;
+import jakarta.persistence.GeneratedValue;
+import jakarta.persistence.GenerationType;
+import jakarta.persistence.Id;
+import jakarta.persistence.JoinColumn;
+import jakarta.persistence.ManyToOne;
+
+/** 用户领到的一张券。 */
+@Entity
+public class UserCoupon {
+
+    @Id
+    @GeneratedValue(strategy = GenerationType.IDENTITY)
+    private Long id;
+
+    @ManyToOne(fetch = FetchType.EAGER, optional = false)
+    @JoinColumn(name = "coupon_id")
+    private Coupon coupon;
+
+    private String customerId;
+
+    @Enumerated(EnumType.STRING)
+    private UserCouponStatus status;
+
+    private Long orderId;
+    private Instant claimedAt;
+
+    protected UserCoupon() {
+    }
+
+    public UserCoupon(Coupon coupon, String customerId, Instant claimedAt) {
+        this.coupon = coupon;
+        this.customerId = customerId;
+        this.status = UserCouponStatus.AVAILABLE;
+        this.claimedAt = claimedAt;
+    }
+
+    public void markUsed(Long orderId) {
+        if (status != UserCouponStatus.AVAILABLE) {
+            throw new BusinessException("优惠券不可用，当前状态：" + status);
+        }
+        this.status = UserCouponStatus.USED;
+        this.orderId = orderId;
+    }
+
+    public void release() {
+        this.status = UserCouponStatus.AVAILABLE;
+        this.orderId = null;
+    }
+
+    public Long getId() {
+        return id;
+    }
+
+    public Coupon getCoupon() {
+        return coupon;
+    }
+
+    public String getCustomerId() {
+        return customerId;
+    }
+
+    public UserCouponStatus getStatus() {
+        return status;
+    }
+
+    public Long getOrderId() {
+        return orderId;
+    }
+
+    public Instant getClaimedAt() {
+        return claimedAt;
+    }
+}
