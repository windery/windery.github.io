new file mode 100644
index 0000000..2c1bacf
--- /dev/null
+++ b/src/test/java/com/example/shop/coupon/CouponConcurrencyTest.java
@@ -0,0 +1,94 @@
+package com.example.shop.coupon;
+
+import static org.assertj.core.api.Assertions.assertThat;
+
+import java.math.BigDecimal;
+import java.time.Duration;
+import java.util.ArrayList;
+import java.util.List;
+import java.util.concurrent.Callable;
+import java.util.concurrent.CountDownLatch;
+import java.util.concurrent.ExecutorService;
+import java.util.concurrent.Executors;
+import java.util.concurrent.Future;
+
+import org.junit.jupiter.api.Test;
+import org.springframework.beans.factory.annotation.Autowired;
+import org.springframework.boot.test.context.SpringBootTest;
+import org.springframework.context.annotation.Import;
+
+import com.example.shop.TestClockConfig;
+import com.example.shop.common.BusinessException;
+
+/**
+ * 并发领券。不能加 @Transactional：每个线程要在自己的事务里提交，才能真正产生竞争。
+ */
+@SpringBootTest
+@Import(TestClockConfig.class)
+class CouponConcurrencyTest {
+
+    @Autowired
+    CouponService coupons;
+    @Autowired
+    UserCouponRepository userCoupons;
+
+    private Coupon coupon(int total) {
+        return coupons.create(new CreateCouponRequest("抢券", new BigDecimal("100"), new BigDecimal("10"), total,
+                TestClockConfig.NOW.plus(Duration.ofDays(1))));
+    }
+
+    /** 让所有任务在同一时刻开始，返回成功的次数。 */
+    private int runConcurrently(List<Callable<UserCoupon>> tasks) throws Exception {
+        ExecutorService pool = Executors.newFixedThreadPool(tasks.size());
+        CountDownLatch start = new CountDownLatch(1);
+        List<Future<UserCoupon>> futures = new ArrayList<>();
+        for (Callable<UserCoupon> task : tasks) {
+            futures.add(pool.submit(() -> {
+                start.await();
+                return task.call();
+            }));
+        }
+        start.countDown();
+        int success = 0;
+        for (Future<UserCoupon> f : futures) {
+            try {
+                f.get();
+                success++;
+            } catch (java.util.concurrent.ExecutionException e) {
+                assertThat(e.getCause()).isInstanceOf(BusinessException.class);
+            }
+        }
+        pool.shutdown();
+        return success;
+    }
+
+    @Test
+    void fiftyCustomersCompeteForTenCoupons() throws Exception {
+        Long id = coupon(10).getId();
+        List<Callable<UserCoupon>> tasks = new ArrayList<>();
+        for (int i = 0; i < 50; i++) {
+            String customer = "rush-" + i;
+            tasks.add(() -> coupons.claim(id, customer));
+        }
+
+        int success = runConcurrently(tasks);
+
+        assertThat(success).isEqualTo(10);
+        assertThat(coupons.get(id).getClaimedCount()).isEqualTo(10);
+        assertThat(userCoupons.findAll().stream().filter(uc -> uc.getCoupon().getId().equals(id))).hasSize(10);
+    }
+
+    @Test
+    void sameCustomerClaimingConcurrentlyGetsOnlyOne() throws Exception {
+        Long id = coupon(100).getId();
+        List<Callable<UserCoupon>> tasks = new ArrayList<>();
+        for (int i = 0; i < 10; i++) {
+            tasks.add(() -> coupons.claim(id, "greedy"));
+        }
+
+        int success = runConcurrently(tasks);
+
+        assertThat(success).isEqualTo(1);
+        assertThat(coupons.get(id).getClaimedCount()).isEqualTo(1);
+    }
+}
