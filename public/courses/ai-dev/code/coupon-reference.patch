+package com.example.shop.coupon;
+
+import org.springframework.data.jpa.repository.JpaRepository;
+import org.springframework.data.jpa.repository.Modifying;
+import org.springframework.data.jpa.repository.Query;
+import org.springframework.data.repository.query.Param;
+
+public interface CouponRepository extends JpaRepository<Coupon, Long> {
+
+    /**
+     * 在还有余量时把已领数量加一，返回受影响的行数（1 表示领到，0 表示已领完）。
+     * 判断和更新在同一条 SQL 里完成，数据库的行锁保证并发时不会超发。
+     */
+    @Modifying(clearAutomatically = true)
+    @Query("update Coupon c set c.claimedCount = c.claimedCount + 1 "
+            + "where c.id = :id and c.claimedCount < c.totalCount")
+    int tryClaimOne(@Param("id") Long id);
+}
