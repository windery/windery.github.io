+package com.example.shop.coupon;
+
+import java.math.BigDecimal;
+import java.time.Instant;
+
+import jakarta.persistence.Entity;
+import jakarta.persistence.GeneratedValue;
+import jakarta.persistence.GenerationType;
+import jakarta.persistence.Id;
+
+@Entity
+public class Coupon {
+
+    @Id
+    @GeneratedValue(strategy = GenerationType.IDENTITY)
+    private Long id;
+
+    private String name;
+    private BigDecimal threshold;
+    private BigDecimal discount;
+    private int totalCount;
+
+    /** 已领取的数量。只通过 CouponRepository.tryClaimOne 的条件更新修改，避免并发超发。 */
+    private int claimedCount;
+
+    private Instant validUntil;
+    private Instant createdAt;
+
+    protected Coupon() {
+    }
+
+    public Coupon(String name, BigDecimal threshold, BigDecimal discount, int totalCount,
+            Instant validUntil, Instant createdAt) {
+        this.name = name;
+        this.threshold = threshold;
+        this.discount = discount;
+        this.totalCount = totalCount;
+        this.validUntil = validUntil;
+        this.createdAt = createdAt;
+    }
+
+    public boolean isExpired(Instant now) {
+        return !now.isBefore(validUntil);
+    }
+
+    public Long getId() {
+        return id;
+    }
+
+    public String getName() {
+        return name;
+    }
+
+    public BigDecimal getThreshold() {
+        return threshold;
+    }
+
+    public BigDecimal getDiscount() {
+        return discount;
+    }
+
+    public int getTotalCount() {
+        return totalCount;
+    }
+
+    public int getClaimedCount() {
+        return claimedCount;
+    }
+
+    public Instant getValidUntil() {
+        return validUntil;
+    }
+}
