# The scheduled AI daily uses only the dedicated read and publish scripts for
# account-bearing commands. These project rules load when .codex is trusted.
prefix_rule(
    pattern = ["twitter"],
    decision = "forbidden",
    justification = "Read the X List through node scripts/fetch-daily-x.mjs.",
)
prefix_rule(
    pattern = ["security"],
    decision = "forbidden",
    justification = "Keychain access belongs inside scripts/fetch-daily-x.mjs.",
)
prefix_rule(
    pattern = ["lark-cli"],
    decision = "forbidden",
    justification = "Send AI daily messages through scripts/publish-daily.mjs.",
)
prefix_rule(
    pattern = ["gh", "repo", "delete"],
    decision = "forbidden",
    justification = "Repository deletion is outside the AI daily workflow.",
)
