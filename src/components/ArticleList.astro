---
import {articleTitle,readingSummary} from '../lib/content';
const {posts,project,full=false}=Astro.props;
---
<ol class:list={['reading-list',{'reading-list-full':full}]} aria-label={`${project.name} 阅读顺序`}>
{posts.map((a:any)=><li><a href={`/projects/${project.slug}/${a.frontmatter.articleSlug}/`}><span class="reading-copy"><span class="reading-title">{articleTitle(a,project.name)}</span>{full&&<span class="reading-description">{readingSummary(a)}</span>}</span><svg viewBox="0 0 20 20" aria-hidden="true"><path d="M4 10h12m-5-5 5 5-5 5"/></svg></a></li>)}
</ol>
