---
import Site from '../../layouts/Site.astro';
import {catalog,projectArticles} from '../../lib/content';
---
<Site title="项目解读"><div class="listing" data-pagefind-ignore><h1>项目解读</h1><p class="lead">先了解用途，再动手使用，最后追踪工作原理。</p>{catalog.projects.map(p=><section class="project-entry"><a class="entry-title" href={`/projects/${p.slug}/`}><h2>{p.name}</h2></a><p>{p.description}</p><ol class="article-links">{projectArticles(p.slug).map(a=><li><a href={`/projects/${p.slug}/${a.frontmatter.articleSlug}/`}>{a.frontmatter.title.replace(p.name+' ','')}</a></li>)}</ol><p class="entry-meta">更新于 {p.updated}</p></section>)}</div></Site>
