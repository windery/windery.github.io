---
import Site from '../layouts/Site.astro';
import {courses,catalog,projectHref,courseStatus} from '../lib/content';
const byUpdated=<T extends {updated:string}>(list:T[])=>[...list].sort((a,b)=>b.updated.localeCompare(a.updated));
const courseList=byUpdated(courses);
const projectList=byUpdated(catalog.projects as any[]);
const owner=(name:string)=>name.includes('/')?name.slice(0,name.lastIndexOf('/')+1):'';
const repo=(name:string)=>name.slice(name.lastIndexOf('/')+1);
const panels=[{id:"courses",label:"课程"},{id:"projects",label:"项目解读"}];
---
<Site title="学习笔记">
<div class="home" data-pagefind-ignore>
 <h1 class="visually-hidden">Windery 学习笔记</h1>
 <div class="home-tabs" role="tablist" aria-label="内容类型" data-tabs hidden>
  {panels.map((p,i)=><button type="button" role="tab" id={`tab-${p.id}`} aria-controls={`panel-${p.id}`} aria-selected={i===0?'true':'false'} tabindex={i===0?0:-1} data-tab={p.id}>{p.label}</button>)}
 </div>

 <section class="home-panel" id="panel-courses" role="tabpanel" aria-labelledby="tab-courses" data-panel="courses">
  <h2 class="panel-title">课程</h2>
  <ul class="course-list">{courseList.map(c=><li>
   <a class="course-card" href={c.href}>
    <span class="course-name">{c.name}</span>
    <span class="course-desc">{c.description}</span>
    <span class="course-meta">{c.detail&&<span>{c.detail}</span>}{c.status&&<span class="status" data-status={c.status}>{courseStatus[c.status]}</span>}</span>
    <svg class="card-arrow" viewBox="0 0 20 20" aria-hidden="true"><path d="M4 10h12m-5-5 5 5-5 5"/></svg>
   </a></li>)}</ul>
 </section>

 <section class="home-panel" id="panel-projects" role="tabpanel" aria-labelledby="tab-projects" data-panel="projects">
  <h2 class="panel-title">项目解读</h2>
  <ul class="project-list">{projectList.map(p=><li>
   <a class="project-row" href={projectHref(p.slug)}>
    <span class="project-name"><span class="project-owner-name">{owner(p.name)}</span>{repo(p.name)}</span>
    <span class="project-desc">{p.description}</span>
    <span class="project-meta"><span class="project-version">{p.version??`commit ${p.commit.slice(0,7)}`}</span><span>{p.articles.length} 篇</span><time datetime={p.updated}>{p.updated}</time></span>
   </a></li>)}</ul>
 </section>
</div>
</Site>
<script>
// Two tabs keep courses and project write-ups apart; the open tab lives in the URL (?tab=projects).
const tabs=document.querySelector<HTMLElement>('[data-tabs]');
if(tabs){
 document.documentElement.classList.add('home-tabbed');
 tabs.hidden=false;
 const tabButtons=[...tabs.querySelectorAll<HTMLButtonElement>('[data-tab]')];
 const panels=[...document.querySelectorAll<HTMLElement>('[data-panel]')];
 const asked=new URLSearchParams(location.search).get('tab');
 let current=panels.some(p=>p.dataset.panel===asked)?asked!:'courses';
 const render=()=>{
  tabButtons.forEach(b=>{const on=b.dataset.tab===current;b.setAttribute('aria-selected',String(on));b.tabIndex=on?0:-1;});
  panels.forEach(p=>{p.hidden=p.dataset.panel!==current;});
  history.replaceState(history.state,'',location.pathname+(current==='courses'?'':`?tab=${current}`)+location.hash);
 };
 tabs.addEventListener('click',e=>{const b=(e.target as Element).closest<HTMLButtonElement>('[data-tab]');if(!b)return;current=b.dataset.tab!;render();});
 tabs.addEventListener('keydown',e=>{
  if(e.key!=='ArrowLeft'&&e.key!=='ArrowRight')return;
  const i=tabButtons.findIndex(b=>b.dataset.tab===current);const next=tabButtons[(i+(e.key==='ArrowRight'?1:tabButtons.length-1))%tabButtons.length];
  current=next.dataset.tab!;render();next.focus();
 });
 render();
}
</script>
