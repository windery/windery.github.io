---
import Site from '../layouts/Site.astro';
import {tracks,libraryEntries,trackName,projectHref} from '../lib/content';
import TrackSection from '../components/TrackSection.astro';
const recent=libraryEntries.slice(0,6);
---
<Site title="学习笔记">
<div class="home" data-pagefind-ignore>
<header class="home-intro"><h1>学过的，<br/>留在这里。</h1><p>沿着课程建立理解，<br/>在真实项目里追踪代码与设计。</p></header>
<nav class="route-overview" aria-label="学习方向">{tracks.map((t,i)=><a href={`#track-${t.slug}`}><span>{String(i+1).padStart(2,'0')}</span>{t.name}</a>)}</nav>
<div class="route">{tracks.map((track,i)=><TrackSection track={track} index={i}/>)}</div>
<section class="home-recent" aria-labelledby="recent-title">
 <h2 id="recent-title">最近更新</h2>
 <ol>{recent.map(({kind,content})=><li><time datetime={content.createdAt}>{content.createdAt.slice(0,10)}</time><span class="recent-kind">{kind==='course'?'课程':'项目解读'} · {trackName(content)}</span><a href={kind==='course'?(content as any).href:projectHref(content.slug)}>{content.name}</a></li>)}</ol>
</section>
</div>
</Site>
