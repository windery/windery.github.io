---
import ArticleToc from '../../../components/ArticleToc.astro';
import DailyTree from '../../../components/DailyTree.astro';
import ReaderScripts from '../../../components/ReaderScripts.astro';
import Site from '../../../layouts/Site.astro';
import '../../../styles/daily.css';
import {dailyIssues,formatDailyDate,editionUrl} from '../../../lib/content';
export function getStaticPaths(){
 return dailyIssues.flatMap(issue=>issue.legacy?[]:issue.editions.map((edition,index)=>({params:{date:issue.date,slug:edition.meta.slug},props:{issue,edition,previous:issue.editions[index-1],next:issue.editions[index+1]}})));
}
const {issue,edition,previous,next}=Astro.props;
const Content=edition.Content;
const headings=edition.getHeadings().filter((h:any)=>h.depth===2||h.depth===3).map((h:any)=>({...h,label:h.text}));
const others=issue.editions.filter(item=>item.meta.slug!==edition.meta.slug);
const publishedTime=issue.meta.generatedAt || `${issue.date}T08:00:00+08:00`;
---
<Site title={edition.meta.title} description={edition.meta.summary} type="article" publishedTime={publishedTime} footerNote="内容以原文链接为准">
<div class="edition-layout">
 <DailyTree issues={dailyIssues} currentDate={issue.date} currentSlug={edition.meta.slug}/>

 <article class="edition-article" id="top" data-pagefind-body>
  <nav class="breadcrumb" aria-label="位置"><a href="/daily/">全部日报</a><span aria-hidden="true">/</span><span>{formatDailyDate(issue.date)}</span></nav>
  <header class="edition-header">
   <p class="edition-meta"><span>{edition.meta.label}</span><time datetime={issue.date}>{formatDailyDate(issue.date)}</time></p>
   <h1>{edition.meta.title}</h1>
   <p class="edition-summary">{edition.meta.summary}</p>
  </header>

  <details class="edition-mobile-toc" data-pagefind-ignore>
   <summary>本期目录 <svg viewBox="0 0 20 20" aria-hidden="true"><path d="m6 8 4 4 4-4"/></svg></summary>
   <nav class="mobile-editions" aria-label="本期文章">{issue.editions.map(item=><a href={editionUrl(issue,item)} aria-current={item.meta.slug===edition.meta.slug?'page':undefined}>{item.meta.label} · {item.meta.title}</a>)}</nav>
   <ArticleToc headings={headings}/>
  </details>

  <div class="daily-prose prose"><Content/></div>

  <nav class="edition-pagination" aria-label="同日上一篇下一篇" data-pagefind-ignore>
   {previous && <a rel="prev" href={editionUrl(issue,previous)}><span>上一篇 · {previous.meta.label}</span><strong>{previous.meta.title}</strong></a>}
   {next && <a rel="next" href={editionUrl(issue,next)}><span>下一篇 · {next.meta.label}</span><strong>{next.meta.title}</strong></a>}
  </nav>

  <section class="related" aria-label="同日其他文章" data-pagefind-ignore>
   <h2>同日其他文章</h2>
   {others.map(item=><a href={editionUrl(issue,item)}>{item.meta.label} · {item.meta.title} →</a>)}
   <a href="/daily/">返回全部日报 →</a>
  </section>

  <footer class="daily-end" data-pagefind-ignore><a href="/daily/">← 全部日报</a><a href="#top">回到顶部 <span aria-hidden="true">↑</span></a></footer>
 </article>

 <aside class="edition-toc" aria-label="本文导航" data-pagefind-ignore>
  <p class="toc-label">本文目录</p>
  <ArticleToc headings={headings}/>
  <a class="daily-back-top" href="#top">回到顶部 <span aria-hidden="true">↑</span></a>
 </aside>
</div>
<ReaderScripts/>
</Site>
