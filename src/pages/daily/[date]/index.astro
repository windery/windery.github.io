---
import LegacyDaily from '../../../components/LegacyDaily.astro';
import {dailyIssues,editionUrl,formatDailyDate} from '../../../lib/content';
export function getStaticPaths(){return dailyIssues.map(issue=>({params:{date:issue.date},props:{issue}}));}
const {issue}=Astro.props;
const index=dailyIssues.findIndex(item=>item.date===issue.date);
const older=dailyIssues[index+1];
const newer=dailyIssues[index-1];
const target=issue.editions[0]?editionUrl(issue,issue.editions[0]):'/daily/';
const title=issue.editions[0]?.meta.title || 'AI 日报';
---
{issue.legacy ? <LegacyDaily issue={issue} older={older} newer={newer}/> : (
<html lang="zh-CN">
<head>
 <meta charset="UTF-8"/>
 <meta name="viewport" content="width=device-width, initial-scale=1"/>
 <meta name="robots" content="noindex"/>
 <title>AI 日报 {formatDailyDate(issue.date)}</title>
 <meta http-equiv="refresh" content={`0;url=${target}`}/>
 <link rel="canonical" href={`https://windery.github.io${target}`}/>
 <script is:inline set:html={`location.replace(${JSON.stringify(target)})`}></script>
</head>
<body><p>正在前往 <a href={target}>{title}</a></p></body>
</html>
)}
