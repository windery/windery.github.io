---
import ArticleToc from '../../components/ArticleToc.astro';
import ReaderScripts from '../../components/ReaderScripts.astro';
import Site from '../../layouts/Site.astro';
import '../../styles/daily.css';
import {dailies,dailyTitle,dailySummary,dailyHighlights,formatDailyDate} from '../../lib/content';
export function getStaticPaths(){return dailies.map(daily=>({params:{date:daily.frontmatter.date},props:{daily}}));}
const {daily}=Astro.props;
const {frontmatter:data,Content}=daily;
const title=dailyTitle(data);
const summary=dailySummary(data);
const highlights=dailyHighlights(data);
const index=dailies.findIndex(item=>item.frontmatter.date===data.date);
const older=dailies[index+1];
const newer=dailies[index-1];
const headings=daily.getHeadings().filter(h=>h.depth===2||h.depth===3).map(h=>({...h,label:h.text}));
---
<Site title={title} description={summary} type="article" publishedTime={data.generatedAt || `${data.date}T08:00:00+08:00`} footerNote="内容以原文链接为准">
<div class="daily-layout">
 <article class="daily-article" id="daily-top" data-pagefind-body>
  <div class="daily-meta" data-pagefind-ignore>
   <nav class="breadcrumb" aria-label="位置"><a href="/daily/">全部日报</a><span aria-hidden="true">/</span><span>{formatDailyDate(data.date)}</span></nav>
  </div>
  <header class="daily-header">
   <p class="daily-eyebrow"><span>WINDERY / AI DAILY</span><time datetime={data.date}>{formatDailyDate(data.date)}</time></p>
   <h1>{title}</h1>
   <p class="daily-summary">{summary}</p>
  </header>
  <details class="daily-mobile-toc" data-pagefind-ignore><summary>本期目录 <svg viewBox="0 0 20 20" aria-hidden="true"><path d="m6 8 4 4 4-4"/></svg></summary><ArticleToc headings={headings}/></details>
  <div class="daily-prose prose"><Content/></div>

  <section class="daily-key-points-bottom" id="daily-key-points" data-pagefind-ignore>
   <h2>本期要点</h2>
   <ol>{highlights.map(item=><li>{item}</li>)}</ol>
  </section>

  <nav class="daily-pagination" aria-label="相邻日报" data-pagefind-ignore>
   {older && <a rel="prev" href={`/daily/${older.frontmatter.date}/`}><span>上一期 · {formatDailyDate(older.frontmatter.date)}</span><strong>{dailyTitle(older.frontmatter)}</strong></a>}
   {newer && <a rel="next" href={`/daily/${newer.frontmatter.date}/`}><span>下一期 · {formatDailyDate(newer.frontmatter.date)}</span><strong>{dailyTitle(newer.frontmatter)}</strong></a>}
  </nav>
  <footer class="daily-end" data-pagefind-ignore><a href="/daily/">← 阅读往期日报</a><a href="#daily-top">回到本期顶部 <span aria-hidden="true">↑</span></a></footer>
 </article>

 <aside class="daily-sidebar" aria-label="本期导航" data-pagefind-ignore>
  <p class="toc-label">本期目录</p>
  <ArticleToc headings={headings}/>
  <div class="daily-key-points"><h2>本期要点</h2><ol>{highlights.map(item=><li>{item}</li>)}</ol></div>
  <a class="daily-back-top" href="#daily-top">回到顶部 <span aria-hidden="true">↑</span></a>
 </aside>
</div>
<ReaderScripts/>
</Site>
