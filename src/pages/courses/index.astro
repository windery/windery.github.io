---
import Site from '../../layouts/Site.astro';
import {tracks} from '../../lib/content';
import TrackSection from '../../components/TrackSection.astro';
---
<Site title="课程"><div class="listing listing-wide" data-pagefind-ignore><h1>课程</h1><p class="lead">按学习路线排列：先夯实 Java 与架构，再转向 AI 开发，拓展阅读放在最后。</p><div class="route">{tracks.map(track=><TrackSection track={track} showProjects={false}/>)}</div></div></Site>
