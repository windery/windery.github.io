---
import Site from '../../layouts/Site.astro';
import {tracks} from '../../lib/content';
import TrackSection from '../../components/TrackSection.astro';
---
<Site title="课程"><div class="listing listing-wide" data-pagefind-ignore><h1>课程</h1><p class="lead">以读懂代码为目标，按方向分组，按自己的节奏学习。</p><div class="route">{tracks.map((track,i)=><TrackSection track={track} index={i} showProjects={false}/>)}</div></div></Site>
